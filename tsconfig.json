{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "isolatedModules": true,

        "rootDir": "src",
        "outDir": "dist",

        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,

        "skipLibCheck": true,

        "sourceMap": true,
        "declaration": true,

        "types": [
            "node",
            "jest"
        ]
    },

    "include": [
        "src/**/*.ts"
    ],

    "exclude": [
        "node_modules",
        "dist"
    ]
}